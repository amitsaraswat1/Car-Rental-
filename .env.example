# Royal Route - Environment Variables Configuration
# Copy this file to .env.local for local development or set them in Vercel / Render Project Settings for production.

# 1. Admin Authentication
ADMIN_EMAIL=admin@royalroute.in
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_SESSION_SECRET=royal_route_car_rental_super_secret_session_key_2025

# 2. Resend Email Delivery (Optional)
# If provided, inquiry notifications will be sent directly to the business owner's email inbox.
# If omitted, inquiries will be cleanly simulated and logged to the terminal console without errors.
RESEND_API_KEY=re_your_api_key_here

# 3. Notification Email Recipients
# The email address that should receive customer inquiry alerts:
OWNER_EMAIL=bookings@royalroute.in

# 4. Verified From Email
# For free Resend test accounts use: onboarding@resend.dev
# After verifying your custom domain on Resend, change to: inquiries@royalroute.in
EMAIL_FROM=Royal Route Inquiries <onboarding@resend.dev>

# 5. Google Sheets Webhook Dispatch (Optional)
# If you want every inquiry automatically added as a new row in a Google Sheet,
# paste your Google Apps Script Web App URL or Zapier / Make webhook URL here:
# GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec

# 6. Site URL (Optional, for SEO / absolute URLs)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

